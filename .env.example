# URL project Supabase, contoh https://abcdefgh.supabase.co
# Jangan sertakan akhiran /rest/v1
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) atau anon key lama (eyJ...).
# Nilai ini publik dan dilindungi RLS. Jangan memakai service role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
